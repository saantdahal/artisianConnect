# --- Database (Neon Postgres) ---
# Prisma connects through the Neon serverless driver adapter, so this must be
# a Neon Postgres connection string (Neon dashboard -> Connection Details).
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# --- Auth (better-auth) ---
# Any long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudinary (product/category image uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# --- eSewa (payments, optional in dev - defaults below use eSewa's public test credentials) ---
ESEWA_PRODUCT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_STATUS_CHECK_URL="https://rc.esewa.com.np/api/epay/transaction/status/"
NEXT_PUBLIC_ESEWA_PAYMENT_URL="https://rc.esewa.com.np/api/epay/main/v2/form"
